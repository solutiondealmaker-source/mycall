# ============================================================
# iClone — Local env file
# ------------------------------------------------------------
# Run `bun run setup` to fill this interactively, or copy this
# file to `.env.local` and edit the values manually.
#
# This file is committed; `.env.local` is git-ignored.
# ============================================================

# ── Convex (auto-filled by `bunx convex dev` on first run) ──
# CONVEX_DEPLOYMENT identifies your dev deployment.
# NEXT_PUBLIC_CONVEX_URL is the .convex.cloud endpoint your
# Next.js app hits.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Convex *.convex.site URL — must match NEXT_PUBLIC_CONVEX_URL
# but with the `.convex.site` suffix instead of `.convex.cloud`.
# Used for:
#   - Google OAuth callback (mandatory — see docs/INSTALL.md)
#   - Webhook endpoints (Google Calendar push, Resend events)
# Example:
#   NEXT_PUBLIC_CONVEX_URL=https://acme-rabbit-123.convex.cloud
#   NEXT_PUBLIC_CONVEX_SITE_URL=https://acme-rabbit-123.convex.site
NEXT_PUBLIC_CONVEX_SITE_URL=

# Public base URL of this Next.js app.
# Dev: http://localhost:3000  |  Prod: https://your-domain.com
APP_BASE_URL=http://localhost:3000

# ── Google OAuth — Calendar sync (optional but recommended) ──
# Without these, hosts cannot connect a Google Calendar.
# Slots will still work but no Google Meet links will be generated.
#
# Setup steps (full guide in docs/INSTALL.md §5):
#   1. https://console.cloud.google.com → new project
#   2. APIs & Services → enable "Google Calendar API"
#   3. OAuth consent screen → External → add Test users while in
#      "Testing" mode (or publish & submit for verification)
#   4. Credentials → OAuth Client ID → Web application
#   5. Authorized redirect URI MUST be on convex.site:
#      https://<your-deployment>.convex.site/auth/google/callback
GOOGLE_CLIENT_ID=

# GOOGLE_CLIENT_SECRET is set on the Convex side, not here.
# Run:  bunx convex env set GOOGLE_CLIENT_SECRET <value>

# ============================================================
# Convex-side env vars (set with `bunx convex env set <KEY> <VALUE>`)
# ------------------------------------------------------------
# These are NOT read from this file. They live in Convex's own
# env store, scoped to your deployment.
#
#   SIGNUP_ALLOWED_EMAILS     → allowlist des emails autorisés à CRÉER un compte,
#                               séparés par des virgules (ex: "a@x.com,b@x.com").
#                               REQUIS : vide/absent = inscription fermée
#                               (fail-closed). La connexion des comptes existants
#                               n'est jamais impactée. Sécurise l'inscription
#                               ouverte (audit H1). Set: bunx convex env set
#                               SIGNUP_ALLOWED_EMAILS "you@example.com"
#   RESEND_API_KEY            → https://resend.com/api-keys
#   RESEND_FROM_EMAIL         → e.g. "iClone <noreply@your-domain.com>"
#                               (use "onboarding@resend.dev" for dev sandbox)
#   GOOGLE_CLIENT_ID          → same value as above
#   GOOGLE_CLIENT_SECRET      → Google Cloud OAuth client secret
#   GOOGLE_OAUTH_STATE_SECRET → openssl rand -hex 32
#
# The setup script (`bun run setup`) will set them for you.
# ============================================================
